# ==============================================================================
# NAT LAB - CARRIER GATEWAY CONFORMANCE CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DUAL TOPOLOGY MODE SELECTION
# ------------------------------------------------------------------------------
# Mode A: 'virtual'  - Pure software simulation in Linux netns (zero hardware required)
# Mode B: 'physical' - Single-PC with 2 USB-to-Ethernet adapters (WAN_IF & LAN_IF)
TOPOLOGY_MODE="virtual"
LAB_ROLE="single"
IP_VERSION="4"

# ------------------------------------------------------------------------------
# 2. DUAL USB-TO-ETHERNET PHYSICAL ADAPTERS (For physical mode)
# ------------------------------------------------------------------------------
# USB Adapter 1: Connects host PC to DUT WAN Port
WAN_IF="enx6c1ff76608e2"

# USB Adapter 2: Connects host PC to DUT LAN Port
LAN_IF=""

# Automatically detect connected USB Ethernet adapters if names change
AUTO_DETECT_USB_NICS="1"

# ------------------------------------------------------------------------------
# 3. Linux Bridge & Network Namespace Names
# ------------------------------------------------------------------------------
WAN_BRIDGE="br-test-wan"
LAN_BRIDGE="br-test-lan"
WAN_NS="ns-wan"
DUT_NS="ns-dut"
LAN1_NS="ns-lan1"
LAN2_NS="ns-lan2"
LAN3_NS="ns-lan3"
LAN4_NS="ns-lan4"
LAN_NS="ns-lan1"

# ------------------------------------------------------------------------------
# 4. Upstream WAN Network & Servers (Simulating Carrier Core & SSW)
# ------------------------------------------------------------------------------
WAN_IPV4_CIDR="10.10.0.1/24"
WAN_IPV4_SUBNET="10.10.0.0/24"
WAN_SERVER_IP="10.10.0.1"        # Primary WAN Server / Softswitch (SSW)
WAN_SERVER2_IP="10.10.0.2"       # Secondary WAN Server (for Cone NAT RFC 3489 tests)
WAN_DHCP_POOL_START="10.10.0.100"
WAN_DHCP_POOL_END="10.10.0.200"
WAN_IPV4_ROUTER="10.10.0.1"
WAN_IPV4_DNS="10.10.0.1"
DHCP_VALID_LIFETIME_SEC="43200"
DHCP_RENEW_TIMER_SEC="21600"
DHCP_REBIND_TIMER_SEC="37800"
WAN_DHCP_BACKEND="auto"           # 'kea', 'dnsmasq', or 'auto' (Kea with dnsmasq fallback)
DUT_WAN_IP="10.10.0.150"         # Public IP allocated to DUT WAN
SUPER_DMZ_PUBLIC_IP="10.10.0.150"  # Public IP mapped to Super DMZ terminal
ENABLE_WAN_DHCP="1"              # Serve DHCP on WAN bridge for physical DUT WAN port

# ------------------------------------------------------------------------------
# 5. LAN Network (Standard Gateway Subnet 192.168.1.0/24)
# ------------------------------------------------------------------------------
DUT_LAN_IP="192.168.1.1"
LAN_IPV4_SUBNET="192.168.1.0/24"
LAN1_CLIENT_IP="192.168.1.101" # Standard Wi-Fi Phone / Client
LAN2_CLIENT_IP="192.168.1.102" # Secondary Client (NAT Port Conflict testing)
LAN3_CLIENT_IP="192.168.1.103" # LTE Femtocell Client (Fragmentation testing)
LAN4_CLIENT_IP="192.168.1.104" # Super DMZ / TWIN IP Client
SUPER_DMZ_MAC="02:50:f2:aa:bb:cc"

# ------------------------------------------------------------------------------
# 6. Advanced NAT & Protocol Test Specifications
# ------------------------------------------------------------------------------
NAT_SEQ_PORT_START="1026"
NAT_SKIP_PORTS="1433,1434,4444,9898,1900,2869,3702,57321,3127,2745,17300"
PORT_COLLISION_BASE="5000"           # Base port used to induce deterministic port collisions between clients
PORT_SWEEP_COUNT="500"               # Number of colliding flows per client in Phase 4 (sweeps across 1433/1434)
RTP_CLIENT_PORT="20000"
RTCP_CLIENT_PORT="20001"
SSW_RTP_PORT="30000"
SSW_RTCP_PORT="30001"
DSCP46_MAX_LATENCY_MS="1.0"
DSCP46_PROBE_COUNT="100"
WIRE_RATE_MIN_FRAME_SIZE="1024"
WIRE_RATE_ENGINE="iperf"             # Throughput benchmark engine: 'iperf' [default] or 'iperf3'
WIRE_RATE_TARGET_MBPS="940"          # Minimum wire-rate line throughput target in Mbps on 1GE
WIRE_RATE_FRAMES="1024,1280,1518"    # Ethernet frame sizes (>= 1024B) to benchmark
WIRE_RATE_DURATION_SEC="3"           # Duration per combination per frame size in seconds
WIRE_RATE_TOLERANCE_PCT="95.0"       # Minimum passing percentage of target rate
MULTICAST_GROUP="239.255.1.1"        # Multicast stream destination IP (e.g. IPTV)
MULTICAST_PORT="5001"                # Multicast stream destination UDP port
MULTICAST_BANDWIDTH_MBPS="200"       # Multicast stream target bandwidth in Mbps
MAX_CONCURRENT_SESSIONS="8192"

# ------------------------------------------------------------------------------
# 7. Runtime Directories & Capture Settings
# ------------------------------------------------------------------------------
CAPTURE_DIR="captures"
LOG_DIR="logs"
STATE_DIR="state"
TOOLS_DIR="tools"
CAPTURE_FILTER="udp or tcp or icmp or arp"
RESTORE_INTERFACES_ON_CLEANUP="1"

# ------------------------------------------------------------------------------
# 8. VoIP / SIP Simulation Engine (TC-02)
# ------------------------------------------------------------------------------
# Choose between:
#   'python' - Deterministic RFC 3550 RTP/RTCP socket test (fast, zero-dependency) [DEFAULT]
#   'sipp'   - Full VoIP emulation (SIP INVITE/200 OK signaling + G.711 RTP/RTCP audio playback)
VOIP_TEST_ENGINE="python"
SIPP_SIP_PORT="5060"
SIPP_CALL_DURATION_MS="2500"
